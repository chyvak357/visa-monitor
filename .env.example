TG_CHAT_ID=
TG_TOKEN=

# Диапазон дат, в котором ищем слоты (YYYY-MM-DD). Файл перечитывается на каждом круге.
DATE_FROM=2026-10-04
DATE_TO=2026-11-30
# Как часто проверять, секунд (±20% случайного разброса).
POLL_SECONDS=120
# После алерта держать окно робота на календаре N минут, чтобы бронировать прямо в нём. 0 — не держать.
HOLD_AFTER_ALERT_MIN=10
# Автозапись: 1 — пробный режим (всё заполнить, но «Подтвердить» не нажимать), 0 — записывать по-настоящему.
BOOKING_DRY_RUN=0
# 1 — перед каждой новой сессией перезапускать Chrome (капча реже просит человека), 0 — всё в одном окне.
FRESH_BROWSER=1
# Linux: запускать Chrome во вложенном X-сервере Xephyr (например :99), чтобы он не отбирал фокус. Пусто — как обычно.
NESTED_DISPLAY=99
# 1 — если капча не прошла сама, робот кликает по галочке сам (то же, что `npm start -- --autoclick`).
# С NESTED_DISPLAY кликает курсором Xephyr через xdotool (sudo apt install xdotool), ваша мышь не двигается.
CAPTCHA_AUTOCLICK=0
